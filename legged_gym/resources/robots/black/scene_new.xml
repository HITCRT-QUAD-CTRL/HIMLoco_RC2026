<mujoco model="balck scene">

  <include file="black.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- 并排放置的楼梯，高度从10cm到20cm，每次递增2.5cm -->
    <!-- 楼梯1: 高度10cm -->
    <geom name="stair_1" type="box" pos="-0.6 0 0.05" size="0.3 0.8 0.05" rgba="0.8 0.8 0.8 1"/>
    <!-- 楼梯2: 高度12.5cm -->
    <geom name="stair_2" type="box" pos="-0.3 0 0.0625" size="0.3 0.8 0.0625" rgba="0.75 0.75 0.75 1"/>
    <!-- 楼梯3: 高度15cm -->
    <geom name="stair_3" type="box" pos="0 0 0.075" size="0.3 0.8 0.075" rgba="0.7 0.7 0.7 1"/>
    <!-- 楼梯4: 高度17.5cm -->
    <geom name="stair_4" type="box" pos="0.3 0 0.0875" size="0.3 0.8 0.0875" rgba="0.65 0.65 0.65 1"/>
    <!-- 楼梯5: 高度20cm -->
    <geom name="stair_5" type="box" pos="0.6 0 0.1" size="0.3 0.8 0.1" rgba="0.6 0.6 0.6 1"/>

    <!-- 楼梯末端的平台 -->
    <geom name="platform" type="box" pos="1.2 0 0.1" size="0.4 0.8 0.1" rgba="0.5 0.5 0.5 1"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

</mujoco>